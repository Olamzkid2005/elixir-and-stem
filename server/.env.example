# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elixir_and_stem

# JWT signing secret (never commit the real value)
JWT_SECRET=change-me-to-a-long-random-string

# Server port
PORT=4000

# S3-compatible storage for product photos & license documents
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
