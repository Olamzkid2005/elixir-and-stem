// Elixir & Stem — Prisma schema
// Merchants stay `pending` until an admin approves them (no auto-approval logic anywhere).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  merchant
  admin
}

enum MerchantStatus {
  pending
  approved
  rejected
}

enum OrderStatus {
  placed
  confirmed
  ready_for_pickup
  rider_assigned
  picked_up
  out_for_delivery
  arrived
  delivered
  rejected
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String?
  passwordHash String
  role         Role      @default(customer)
  ageVerified  Boolean   @default(false)
  suspended    Boolean   @default(false)
  createdAt    DateTime  @default(now())

  merchant         Merchant?
  rider            Rider?
  orders           Order[]           @relation("CustomerOrders")
  favorites        Favorite[]
  reviews          Review[]
  loyaltyAccount   LoyaltyAccount?
  pushTokens       PushToken[]

  @@index([email])
  @@index([role])
}

model Merchant {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id])
  businessName    String
  licenseNumber   String
  licenseDocUrl   String?
  bankAccount     String?        // for payouts
  status          MerchantStatus @default(pending) // manual admin approval only
  address         String
  lat             Float
  lng             Float
  stateCode       String?
  rating          Float?         @default(0) // denormalized avg rating
  deliveryEtaMin  Int            @default(45) // estimated min delivery minutes
  deliveryEtaMax  Int            @default(60) // estimated max delivery minutes
  createdAt       DateTime       @default(now())

  products Product[]
  orders   Order[]

  @@index([status])
  @@index([userId])
}

model Product {
  id            String   @id @default(cuid())
  merchantId    String
  merchant      Merchant @relation(fields: [merchantId], references: [id])
  name          String
  brand         String   @default("")
  category      String // Flower | Edibles | Vapes | Concentrates | Tinctures | Topicals
  strainType    String? // sativa | indica | hybrid
  thcPct        Float?
  cbdPct        Float?
  description   String   @default("")
  terpenes      String[] @default([])
  price         Int // base price in cents (see weightOptions for tiers)
  weightOptions Json  // [{ label: "3.5g", price: 4500 }, ...]
  stock         Int      @default(0)
  imageUrl      String?
  imageColor    String?  @default("#d0e9d4") // placeholder art color
  effects       Json?    // [{ icon: "mood", label: "Energetic" }, ...]
  rating        Float?   @default(0) // denormalized avg rating
  reviewCount   Int      @default(0) // denormalized count
  createdAt     DateTime @default(now())

  orderItems  OrderItem[]
  favorites   Favorite[]
  reviews     Review[]

  @@index([merchantId])
  @@index([category])
  @@index([name])
}

model Order {
  id              String      @id @default(cuid())
  customerId      String
  customer        User        @relation("CustomerOrders", fields: [customerId], references: [id])
  merchantId      String
  merchant        Merchant    @relation(fields: [merchantId], references: [id])
  riderId         String?
  rider           Rider?      @relation(fields: [riderId], references: [id])
  status          OrderStatus @default(placed)
  paymentMethod   String      @default("pay_on_delivery")
  deliveryAddress String
  notes           String?
  scheduledFor    DateTime?
  subtotal        Int // cents
  tax             Int
  deliveryFee     Int
  total           Int
  createdAt       DateTime    @default(now())

  items OrderItem[]

  @@index([customerId])
  @@index([merchantId])
  @@index([riderId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id              String  @id @default(cuid())
  orderId         String
  order           Order   @relation(fields: [orderId], references: [id])
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  quantity        Int
  weightLabel     String  @default("")
  priceAtPurchase Int // cents

  review Review?

  @@index([orderId])
  @@index([productId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Review {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  customerId  String
  customer    User      @relation(fields: [customerId], references: [id])
  orderItemId String    @unique // one review per purchased line item
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  rating      Int       // 1-5
  comment     String?
  createdAt   DateTime  @default(now())

  @@index([productId])
  @@index([customerId])
}

model LoyaltyAccount {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  points    Int      @default(0)
  tier      String   @default("bronze") // bronze | silver | gold
  updatedAt DateTime @updatedAt

  transactions LoyaltyTransaction[]

  @@index([userId])
}

model LoyaltyTransaction {
  id        String          @id @default(cuid())
  accountId String
  account   LoyaltyAccount  @relation(fields: [accountId], references: [id])
  orderId   String?
  points    Int // positive = earned, negative = redeemed
  reason    String // "order_earned" | "redeemed_reward" | "signup_bonus"
  createdAt DateTime        @default(now())

  @@index([accountId])
}

model Rider {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  lat         Float?
  lng         Float?
  isOnline    Boolean  @default(false)
  vehicleType String?  // "car", "motorcycle", "bicycle"
  rating      Float    @default(5.0)
  createdAt   DateTime @default(now())

  orders Order[]

  @@index([isOnline])
  @@index([userId])
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  platform  String   // "ios" | "android"
  createdAt DateTime @default(now())

  @@index([userId])
}
